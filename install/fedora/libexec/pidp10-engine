#!/bin/bash
# SPDX-License-Identifier: BSD-2-Clause
#
# Start the PDP-10 engine in the foreground. pidp10-engine@.service runs this
# inside a detached screen session (pidp10-screen -dmS pidp10 ...).
#
# Replaces do_start() from bin/pdpcontrol.sh. Differences that matter:
#   * screen(1) is still there, as upstream had it, because simh reads its
#     sim> prompt from stdin: the telnet listener on $PIDP10_CONSOLE_PORT is
#     the PDP-10's terminal, not the command prompt. systemd supervises the
#     screen session; `pdp` / `pdpcontrol console` attach to it.
#   * no setuid: the caller (systemd) decides privileges.
#   * boot number comes from $1 (systemd instance) or PIDP10_BOOT, and the
#     front-panel boot switch is only consulted when the panel is live.
#   * the simulator runs with cwd = the state tree, so images, tapes and logs
#     land under /var/lib/pidp10 and never next to the executables.
#
# usage: pidp10-engine [boot-number]

set -euo pipefail

# Operator settings first (the same file the units load through EnvironmentFile=),
# then the layout defaults. The conf file is authoritative for policy - what to
# boot, which panel driver, which console port - and the layout is not in it, so
# a PIDP10_STATE set on the command line still picks a scratch tree.
[ -r /etc/pidp10/pidp10.conf ] && . /etc/pidp10/pidp10.conf
: "${PIDP10_PREFIX:=/usr/share/pidp10}"
: "${PIDP10_LIBEXEC:=/usr/libexec/pidp10}"
: "${PIDP10_STATE:=/var/lib/pidp10}"
# The system directories live with the images, not with the read-only data:
# every boot script starts with `cd systems/<name>` and simh resolves every
# attach relative to its cwd, so script and image are one directory. That
# directory is $(PIDP10_STATE)/systems, which is also where
# pidp10-fetch-images unpacks the media.
: "${PIDP10_SYSTEMS:=$PIDP10_STATE/systems}"
: "${PIDP10_SELECTIONS:=$PIDP10_SYSTEMS/selections}"
: "${PIDP10_CONF_DATA:=$PIDP10_PREFIX/conf}"
: "${PIDP10_CONSOLE_PORT:=1025}"

PIDP10_PANEL=${PIDP10_PANEL:-auto}
PIDP10_BOOTSCRIPT=${PIDP10_BOOTSCRIPT:-auto}
SELECTIONS=$PIDP10_SELECTIONS

# Everything here runs on screen's terminal, which the journal never sees, so
# status lines also go to the journal (under the unit, as this runs in its
# cgroup).
say() {
	local prio=$1; shift
	echo "pidp10-engine: $*" >&2
	command -v systemd-cat >/dev/null 2>&1 &&
		printf 'pidp10-engine: %s\n' "$*" | systemd-cat -t pidp10-engine -p "$prio"
	return 0
}
die() { say err "$*"; exit 1; }

[ -r "$SELECTIONS" ] || die "$SELECTIONS not found (is pidp10 installed, or set PIDP10_HOME to a checkout?)"

# ---------------------------------------------------------------------------
# 1. boot number
# ---------------------------------------------------------------------------
instance=${1:-}
# pidp10-engine@default.service: the boot number comes from PIDP10_BOOT or the
# front panel switches, exactly as if no instance had been given.
[ "$instance" = default ] && instance=
have_instance=0
if [ -n "$instance" ]; then
	have_instance=1
	boot_number=$instance          # systemd instances are passed in decimal,
	                               # but accept octal too (0200 == tops20)
	[[ $boot_number =~ ^[0-9]+$ ]] || die "bad boot number '$instance'"
	if [[ $boot_number =~ ^0[0-7]+$ ]]; then
		boot_number=$((8#$boot_number))
	fi
else
	boot_number=${PIDP10_BOOT:-1}
fi

# ---------------------------------------------------------------------------
# 2. front panel present?
# ---------------------------------------------------------------------------
panel_live=0
case "$PIDP10_PANEL" in
	gpiod|gpiomem) panel_live=1 ;;
	sim|none)      panel_live=0 ;;
	auto)
		# Ask the code that would have to drive the panel, do not guess from
		# the shell. The heuristic this replaces was
		#     gpioinfo | grep -q 'rp1\|gpio'
		# which is true on every machine that has GPIO at all: a Qualcomm
		# laptop has eleven gpiochips, most of them PMIC power rails. The
		# engine then believed it had a cabinet and waited in the .pidp boot
		# script for a READ IN press nobody could make.
		#
		# pidp-gpio-probe implements the same test the simulator uses
		# (Broadcom controller, enough lines, every panel line free) and
		# honours PIDP10_GPIO_CHIP, so there is one answer, not two.
		probe=$(command -v pidp-gpio-probe || true)
		[ -x "$probe" ] || probe=$(dirname "$PIDP10_PREFIX")/bin/pidp-gpio-probe
		if [ -x "$probe" ]; then
			"$probe" --check >/dev/null 2>&1 && panel_live=1
		else
			# No probe: assume no cabinet. Booting to the console is
			# wrong far less often than waiting forever for a button.
			echo "pidp10-engine: pidp-gpio-probe not found; assuming no" >&2
			echo "pidp10-engine: front panel (build src/utils/pinctrl, or set" >&2
			echo "pidp10-engine: PIDP10_PANEL=gpiod to override)" >&2
		fi
		;;
esac

# With a live panel and no explicit boot number, ask the maintenance panel
# switch what to boot (that is what scansw10 is for).
if [ "$have_instance" -eq 0 ] && [ "$panel_live" -eq 1 ] && \
   command -v scansw10 >/dev/null 2>&1; then
	# scansw10 prints the 18-bit maintenance switch register on stdout, in
	# decimal; the selection table below is keyed on its low 12 bits, which
	# is also what simh's attach numbers are compared against. (It used to
	# report the value in its exit status, and an exit status is eight bits.)
	if sw=$(scansw10 </dev/null 2>/dev/null) && [ -n "$sw" ]; then
		boot_number=$(( sw & 07777 ))
		echo "pidp10-engine: front panel switches select boot $boot_number"
	fi
fi

# ---------------------------------------------------------------------------
# 3. system name + which engine binary
# ---------------------------------------------------------------------------
sys_oct=$(printf '%04o' "$boot_number")
sel=$(awk -v n="$sys_oct" '$1 == n { print $2; found=1; exit }
                          END { if (!found) print "hills-blinky" }' < "$SELECTIONS")

# The boot script and the images it attaches are the same directory (see
# PIDP10_SYSTEMS above), so a missing directory means the selection table
# names a system that is not installed; a missing image only means
# pidp10-fetch-images has not run yet, which is not fatal here.
bootdir=$PIDP10_SYSTEMS/$sel
[ -d "$bootdir" ] || die "no such system directory: $bootdir"

if   [ "$boot_number" -ge 64 ]; then pidp_bin=pdp10-kl
elif [ "$boot_number" -ge 16 ]; then pidp_bin=pdp10-ki
else                                  pidp_bin=pdp10-ka
fi

# ---------------------------------------------------------------------------
# 4. boot .pidp (wait for READ IN on the panel) or .pi (auto-boot from PTR)
# ---------------------------------------------------------------------------
case "$PIDP10_BOOTSCRIPT" in
	pi)   ext=.pi  ;;
	pidp) ext=.pidp ;;
	auto)
		# Upstream tied this to "was a boot number given", i.e. `pdpcontrol
		# start 1` means "I am not sitting in front of the panel". Keep that
		# behaviour, but require a live panel for .pidp as well.
		if [ "$have_instance" -eq 0 ] && [ "$panel_live" -eq 1 ]; then
			ext=.pidp
		else
			ext=.pi
		fi
		;;
	*) die "PIDP10_BOOTSCRIPT must be pi|pidp|auto" ;;
esac

bootfile=$bootdir/boot$ext
[ -f "$bootfile" ] || die "missing $bootfile"

# Where the simulator runs. The boot scripts do `cd systems/<name>` relative to
# here, so this is what makes the images in the STATE tree the ones that get
# attached - and it is why the boot scripts are installed there too: the file
# simh is handed and the directory it cd's into are one and the same tree.
statedir=$PIDP10_STATE

# ---------------------------------------------------------------------------
# 5. tell the boot scripts that cbridge/tv11 are supervised elsewhere
# ---------------------------------------------------------------------------
export PIDP10_MANAGED=1
export PIDP10_CONSOLE_PORT PIDP10_PANEL PIDP10_GPIO_CHIP PIDP10_CONF_DATA

# The engine itself: from PATH on a packaged system, from the checkout when
# PIDP10_HOME points at one. A developer runs this from a checkout, where the
# engine they just built is in src/pdp10/BIN - prefer that over the installed
# one, which is exactly how a fix appears not to work.
pidp_path=$(command -v "$pidp_bin" || true)
[ -x "$pidp_path" ] || pidp_path=${PIDP10_HOME:-}/src/pdp10/BIN/$pidp_bin
[ -x "$pidp_path" ] || pidp_path=$(dirname "$PIDP10_PREFIX")/bin/$pidp_bin
[ -x "$pidp_path" ] || pidp_path=${PIDP10_HOME:-}/bin/$pidp_bin
[ -x "$pidp_path" ] || die "$pidp_bin not found (build src/pdp10 with: make PIDP10=1)"

# ---------------------------------------------------------------------------
# 6. display for the SDL windows (Type 340, DD)
# ---------------------------------------------------------------------------
# The engine runs as the pidp10 system user, so it can only open windows on a
# display that lets it in: pidp10-xhost.service in the desktop session runs
# "xhost +SI:localuser:pidp10". With no X server socket at all (a headless
# cabinet), use SDL's dummy driver so simh never blocks or fails on a display.
: "${PIDP10_DISPLAY=:0}"
xsock=/tmp/.X11-unix/X${PIDP10_DISPLAY#:}
xsock=${xsock%%.*}
if [ -n "$PIDP10_DISPLAY" ] && [ -S "$xsock" ]; then
	export DISPLAY=$PIDP10_DISPLAY
	export SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-x11}
	display_msg="display=$DISPLAY"
else
	unset DISPLAY
	export SDL_VIDEODRIVER=dummy
	display_msg="display=none"
fi

say notice "boot=$boot_number ($sys_oct) system=$sel engine=$pidp_bin script=$ext console=tcp/$PIDP10_CONSOLE_PORT $display_msg data=$bootdir state=$statedir"

# simh resolves every attach/eval relative to its cwd, and the boot scripts
# expect to start at the state root. Not the bin dir, as upstream did: that is
# how disk images ended up being written next to the executables.
cd "$PIDP10_STATE" || die "cannot enter $PIDP10_STATE"
exec "$pidp_path" "$bootfile"
