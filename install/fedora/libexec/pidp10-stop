#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
#
# ExecStop for the engine units: power simh off through its own prompt.
#
#   pidp10-stop [session]        session: pidp10 (default) or pidp6
#
# The engine runs in a detached screen session (see pidp10-screen), and that
# session's terminal is simh's stdin, so the prompt is reachable: Ctrl-E (simh's
# break key) stops a running guest, the CR clears a half-typed line, and "quit"
# exits. simh flushes its disk and tape buffers on the way out, which a SIGKILL
# would lose.
#
# The previous version typed the same keys into the telnet console on port
# 1025. That never reached simh: the console is the PDP-10's terminal, not the
# command prompt. The ^E halted the machine into a prompt on /dev/null and
# systemd's SIGTERM did the actual stopping.
#
# This is a POWER switch, not an OS shutdown: shut ITS down from the console
# first (or halt it from the panel).

session=${1:-pidp10}
# The units set this; default it for a hand run.
export SCREENDIR=${SCREENDIR:-/run/pidp10/screen}

alive() { screen -ls "$session" 2>/dev/null | grep -q "\.$session[[:space:]]"; }

alive || exit 0
screen -S "$session" -X stuff "$(printf '\005\r')"
sleep 0.3
screen -S "$session" -X stuff "$(printf 'quit\r')"
i=0
while alive && [ "$i" -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done
if alive; then
	echo "pidp10-stop: $session did not quit within 10s, closing the session" >&2
	screen -S "$session" -X quit
fi
exit 0
