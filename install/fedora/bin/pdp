#!/bin/bash
# SPDX-License-Identifier: BSD-2-Clause
#
# pdp - front door to the PiDP-10 (Fedora replacement for bin/pdp.sh)
#
# Upstream's pdp.sh is a 193-line /bin/csh script full of `setenv`, backtick
# subprocesses and `cd /opt/pidp10/...`. This is the bash version: same verbs,
# no csh, and no dependency on the tree living at one particular path.
#
# The difference that matters on Fedora: programs are looked up on PATH, then in
# $PIDP10_BIN (empty by default: an extra directory for a locally built device
# sim), then in a checkout. Nothing here assumes /opt/pidp10.

set -uo pipefail

# Operator settings first (the same file the units load through EnvironmentFile=),
# then the layout defaults. The conf file is authoritative for policy - what to
# boot, which panel driver, which console port - and the layout is not in it, so
# a PIDP10_STATE set on the command line still picks a scratch tree.
[ -r /etc/pidp10/pidp10.conf ] && . /etc/pidp10/pidp10.conf
: "${PIDP10_BIN:=}"
: "${PIDP10_STATE:=/var/lib/pidp10}"
: "${PIDP10_CONSOLE_PORT:=1025}"
: "${PIDP10_LIBEXEC:=/usr/libexec/pidp10}"

PIDP10_TV11_PORT=${PIDP10_TV11_PORT:-10011}

usage() {
	cat <<'EOF'
usage: pdp [command]

  (none)          attach to the PDP-10's simh session (^E for sim>, Ctrl-A d detaches)
  sim             the same
  view            show the virtual front panel in a browser
  con             console (Teletype emulator with sound)
  telcon          plain terminal console (telnet)
  console         alias for telcon
  vt52            VT52 terminal (DECwriter)
  vt05            VT05 terminal
  tvcon           TV Typer (tv11 client)
  tek             TEKTRONIX 4010-1 terminal
  imlac           IMLAC PDS-1 Dumb Terminal
  dp3300          DIGITAL EQUIPMENT DP-3300 (DECwriter II)
  type340         ADSEC Type 340 console
  gt40            GT-40 / Pictor 501 display
  pdp6            attach to the PDP-6's session: its console and sim>
                  (pidp10-pdp6.service)

The engine is a system unit running in a screen session:
pdpcontrol start [boot], pdpcontrol status. Attaching needs membership of the
pidp10 group.
EOF
}

# Resolve a client program: PATH first (that is where this package and the
# device-sim packages put things), then $PIDP10_BIN for something built locally,
# then a development checkout.
pdp_tool() {
	local t=$1 f
	if [ "${t#*/*}" != "$t" ]; then
		[ -x "$t" ] && { echo "$t"; return 0; }
		return 1
	fi
	f=$(command -v "$t" 2>/dev/null || true)
	[ -n "$f" ] && { echo "$f"; return 0; }
	for d in "$PIDP10_BIN" "${PIDP10_HOME:-}/bin" "${PIDP10_HOME:-}/src/utils"; do
		[ -x "$d/$t" ] && { echo "$d/$t"; return 0; }
	done
	return 1
}

missing() {
	echo "pdp: $1 not found." >&2
	case "$1" in
		vt52|vt05|vt50|tvcon|tek4010|imlac|dp3300|dm2500|cbridge|tv11|supdup|gw|mlftp|shutdown|mkpty33)
			echo "pdp: $1 is a device simulator: its own package, see packaging/README.md" >&2 ;;
		*)	echo "pdp: build it from src/ with make, or install its package" >&2 ;;
	esac
	return 1
}

# client <terminal> <command...>: run a client inside a terminal emulator so it
# has a real TTY and a UTF-8 locale. $TERM is set per emulator; xterm -e takes
# the command as separate words, tilix -e takes one string.
client() {
	local term=$1; shift
	local cmd=$*
	local wrapper=${PIDP10_TERMINAL:-}

	if [ -z "$wrapper" ]; then
		for w in tilix gnome-terminal xfce4-terminal xterm; do
			command -v "$w" >/dev/null 2>&1 && { wrapper=$w; break; }
		done
	fi
	[ -n "$wrapper" ] || { echo "pdp: no terminal emulator found (set PIDP10_TERMINAL)" >&2; return 1; }

	case "$wrapper" in
		tilix)          exec tilix          --window -e "$cmd" ;;
		gnome-terminal) exec gnome-terminal -- "$cmd" ;;
		xfce4-terminal) exec xfce4-terminal -e "$cmd" ;;
		xterm)          exec env TERM=xterm-256color xterm -e $cmd ;;
		*)              exec "$wrapper" sh -c "$cmd" ;;
	esac
}

cmd=${1:-sim}
shift || true

case "$cmd" in
  sim)
	# Upstream's bare `pdp` was `screen -Dr pidp10`; this is that, for a
	# session owned by the pidp10 system user (see libexec/pidp10-session).
	exec "$PIDP10_LIBEXEC/pidp10-session" pidp10 attach
	;;
  view)
	# The browser applet is data under the prefix; it opens simh's own telnet
	# view (port 10001), not the console port.
	${BROWSER:-xdg-open} "http://localhost:10001/" >/dev/null 2>&1 ||
		exec xdg-open "http://localhost:10001/"
	;;
  con)
	t=$(pdp_tool sty) || missing sty
	client tilix "\"$t\" -e telnet localhost $PIDP10_CONSOLE_PORT"
	;;
  telcon|console)
	client xterm "telnet localhost $PIDP10_CONSOLE_PORT"
	;;
  vt52)
	t=$(pdp_tool vt52) || missing vt52
	client tilix "\"$t\" -l en -p $PIDP10_CONSOLE_PORT localhost"
	;;
  vt05)
	t=$(pdp_tool vt05) || missing vt05
	client tilix "\"$t\" -p $PIDP10_CONSOLE_PORT localhost"
	;;
  tvcon)
	t=$(pdp_tool tvcon) || missing tvcon
	client tilix "\"$t\" -p $PIDP10_TV11_PORT localhost"
	;;
  tek|tek4010)
	t=$(pdp_tool tek4010) || missing tek4010
	client tilix "\"$t\""
	;;
  imlac)
	t=$(pdp_tool imlac) || missing imlac
	client tilix "\"$t\""
	;;
  dp3300|dp3300-ascii)
	t=$(pdp_tool dp3300) || missing dp3300
	client tilix "\"$t\" -ascii"
	;;
  type340|sty)
	t=$(pdp_tool sty) || missing sty
	client tilix "\"$t\" -e telnet localhost $PIDP10_CONSOLE_PORT"
	;;
  gt40|pictor)
	t=$(pdp_tool dm2500) || missing dm2500
	client tilix "\"$t\" -t gt40"
	;;
  pdp6)
	# The PDP-6 has no telnet console: its console is its screen session, so
	# the PDP-6 terminal and its sim> prompt are one place.
	exec "$PIDP10_LIBEXEC/pidp10-session" pidp6 attach
	;;
  pdp6-tty)
	echo "pdp: the PDP-6 console is its screen session now: 'pdp pdp6'" >&2
	exit 2
	;;
  tv11-tty)
	echo "pdp: tv11-tty is not offered by this package; for the Knight TV" >&2
	echo "pdp: use pidp10-tv11.service and 'pdp tvcon'." >&2
	exit 2
	;;
  -h|--help|help)
	usage
	;;
  *)
	echo "pdp: unknown command '$cmd'" >&2
	usage
	exit 2
	;;
esac
