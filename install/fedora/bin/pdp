#!/bin/bash
# SPDX-License-Identifier: BSD-2-Clause
#
# pdp - front door to the PiDP-10 (Fedora replacement for bin/pdp.sh)
#
# Upstream's pdp.sh is a 193-line /bin/csh script full of `setenv`, backtick
# subprocesses and `cd /opt/pidp10/...`. This is the bash version: same verbs,
# no csh, and no dependency on the tree living at one particular path.
#
# The difference that matters on Fedora: programs are looked up on PATH, then in
# $PIDP10_BIN (empty by default: an extra directory for a locally built device
# sim), then in a checkout. Nothing here assumes /opt/pidp10.

set -uo pipefail

# Operator settings first (the same file the units load through EnvironmentFile=),
# then the layout defaults. The conf file is authoritative for policy - what to
# boot, which panel driver, which console port - and the layout is not in it, so
# a PIDP10_STATE set on the command line still picks a scratch tree.
[ -r /etc/pidp10/pidp10.conf ] && . /etc/pidp10/pidp10.conf
: "${PIDP10_BIN:=}"
: "${PIDP10_STATE:=/var/lib/pidp10}"
: "${PIDP10_CONSOLE_PORT:=1025}"
: "${PIDP10_LIBEXEC:=/usr/libexec/pidp10}"
: "${PIDP10_PREFIX:=/usr/share/pidp10}"

# tvcon's port on the tv11 display server. Empty = tvcon's own default, which
# is what tv11 serves on; not 10011, which is the KA10's TEN11 port that tv11
# itself connects to.
PIDP10_TV11_PORT=${PIDP10_TV11_PORT:-}

usage() {
	cat <<'EOF'
usage: pdp [command]

  (none)          attach to the PDP-10's simh session (^E for sim>, Ctrl-A d detaches)
  sim             the same
  view            all-in-one tilix layout (KA10 session, console, Knight TV)
  view-setup      add the tilix profiles 'view' needs (once per user)
  con             console (Teletype emulator with sound)
  telcon          plain terminal console (telnet)
  console         alias for telcon
  vt52            VT52 on ITS terminal line 9 (port 10018)
  vt05            VT05 on ITS terminal line 9 (port 10018)
  tvcon           Knight TV (tvcon, from tv11; pidp10-tv11@.service)
  tek             Tektronix 4010 on ITS line 8 (port 10017)
  imlac           IMLAC PDS-1 on ITS line 7 (port 10016)
  dp3300          Datapoint 3300 on ITS line 15 (port 10020)
  type340         reopen the KA10's Type 340 display window
  sty             Teletype emulator on the console (as con)
  gt40            GT40 (Open SIMH pdp11 + VT11) on ITS line 11 (port 10019)
  pdp6            attach to the PDP-6's session: its console and sim>
                  (pidp10-pdp6.service)

The engine is a system unit running in a screen session:
pdpcontrol start [boot], pdpcontrol status. Attaching needs membership of the
pidp10 group.
EOF
}

# Resolve a client program: PATH first (that is where this package and the
# device-sim packages put things), then $PIDP10_BIN for something built locally,
# then a development checkout.
pdp_tool() {
	local t=$1 f
	if [ "${t#*/*}" != "$t" ]; then
		[ -x "$t" ] && { echo "$t"; return 0; }
		return 1
	fi
	f=$(command -v "$t" 2>/dev/null || true)
	[ -n "$f" ] && { echo "$f"; return 0; }
	for d in "$PIDP10_BIN" "${PIDP10_HOME:-}/bin" "${PIDP10_HOME:-}/src/utils"; do
		[ -x "$d/$t" ] && { echo "$d/$t"; return 0; }
	done
	return 1
}

missing() {
	echo "pdp: $1 not found." >&2
	case "$1" in
		vt52|vt05|vt50|tvcon|tek4010|imlac|dp3300|dm2500|cbridge|tv11|supdup|gw|mlftp|shutdown|mkpty33|open-simh-pdp11)
			echo "pdp: $1 is a device simulator: its own package, see packaging/README.md" >&2 ;;
		*)	echo "pdp: build it from src/ with make, or install its package" >&2 ;;
	esac
	exit 1
}

# client <terminal> <command...>: run a client inside a terminal emulator so it
# has a real TTY and a UTF-8 locale. $TERM is set per emulator; xterm -e takes
# the command as separate words, tilix -e takes one string.
client() {
	local term=$1; shift
	local cmd=$*
	local wrapper=${PIDP10_TERMINAL:-}

	if [ -z "$wrapper" ]; then
		for w in tilix gnome-terminal xfce4-terminal xterm; do
			command -v "$w" >/dev/null 2>&1 && { wrapper=$w; break; }
		done
	fi
	[ -n "$wrapper" ] || { echo "pdp: no terminal emulator found (set PIDP10_TERMINAL)" >&2; return 1; }

	# $cmd is one string of shell words. tilix -e splits it itself, but only
	# without --action: through --action=app-new-window the whole string
	# became the program name ("Failed to execute child process 'telnet
	# localhost 1026'"). tilix has no --window either: that option is
	# gnome-terminal's. gnome-terminal takes argv after --, so its command
	# goes through sh -c instead of arriving as a single unsplit argument.
	#
	# The terminal is started detached (setsid -f), so pdp returns at once
	# and closing the shell it was typed in does not take the window with
	# it. Otherwise it depends on the emulator: tilix stays in the
	# foreground whenever it is the first instance (it becomes the server
	# for later windows), xterm always does, gnome-terminal never does.
	local -a argv
	case "$wrapper" in
		tilix)          argv=(tilix -e "$cmd") ;;
		gnome-terminal) argv=(gnome-terminal --window -- sh -c "$cmd") ;;
		xfce4-terminal) argv=(xfce4-terminal -e "$cmd") ;;
		# shellcheck disable=SC2206 # xterm -e takes separate words
		xterm)          argv=(env TERM=xterm-256color xterm -e $cmd) ;;
		*)              argv=("$wrapper" sh -c "$cmd") ;;
	esac
	setsid -f "${argv[@]}" </dev/null >/dev/null 2>&1
}

# gui <program> [args...]: a device simulator that opens its own window and
# runs its own connection (vt52 -B telnet ..., tek4010 telnet ...). Upstream
# started these with nohup ... &; they need no terminal around them.
gui() {
	setsid -f "$@" </dev/null >/dev/null 2>&1
}

# The ITS terminal lines the device sims attach to - systems/its/boot.*:
#   at -u mty line=7,10016   imlac           at -u dpk line=11,10019  gt40
#   at -u mty line=8,10017   tek4010         at -u dpk line=15,10020  dp3300
#   at -u mty line=9,10018   vt52 / vt05
PORT_TEK=10017
PORT_VT=10018
PORT_DP3300=10020

cmd=${1:-sim}
shift || true

case "$cmd" in
  sim)
	# Upstream's bare `pdp` was `screen -Dr pidp10`; this is that, for a
	# session owned by the pidp10 system user (see libexec/pidp10-session).
	exec "$PIDP10_LIBEXEC/pidp10-session" pidp10 attach
	;;
  view)
	# Upstream's `pdp view`: the all-in-one tilix layout (KA10 session,
	# console, Knight TV log). Not a web page - nothing serves one. Its panes
	# use tilix profiles that have to be in the user's dconf first.
	command -v tilix >/dev/null 2>&1 || { missing tilix; exit 1; }
	if ! "$PIDP10_LIBEXEC/pidp10-tilix-profiles" --check 2>/dev/null; then
		echo "pdp: the PiDP-10 tilix profiles are not set up for $(id -un);" >&2
		echo "pdp: run 'pdp view-setup' once (adds them, keeps your own)." >&2
		exit 1
	fi
	setsid -f tilix -s "$PIDP10_PREFIX/view.json" </dev/null >/dev/null 2>&1
	;;
  view-setup)
	exec "$PIDP10_LIBEXEC/pidp10-tilix-profiles"
	;;
  con)
	t=$(pdp_tool sty) || missing sty
	client tilix "\"$t\" -e telnet localhost $PIDP10_CONSOLE_PORT"
	;;
  telcon|console)
	client xterm "telnet localhost $PIDP10_CONSOLE_PORT"
	;;
  vt52)
	t=$(pdp_tool vt52) || missing vt52
	gui "$t" -B telnet localhost "$PORT_VT"
	;;
  vt05)
	t=$(pdp_tool vt05) || missing vt05
	gui "$t" -B telnet localhost "$PORT_VT"
	;;
  tvcon)
	# Upstream: tvcon -2BS localhost. tvcon opens its own SDL window, so it
	# runs detached rather than inside a terminal.
	t=$(pdp_tool tvcon) || { missing tvcon; exit 1; }
	setsid -f "$t" -2BS ${PIDP10_TV11_PORT:+-p "$PIDP10_TV11_PORT"} localhost \
	    </dev/null >/dev/null 2>&1
	;;
  tek|tek4010)
	t=$(pdp_tool tek4010) || missing tek4010
	gui "$t" -b9600 telnet localhost "$PORT_TEK"
	;;
  imlac)
	# imlac.simh attaches the IMLAC's tty to ITS line 7 (port 10016) and
	# loads the ssv22 ROM by absolute path.
	t=$(pdp_tool imlac) || missing imlac
	gui "$t" "$PIDP10_PREFIX/conf/imlac.simh"
	;;
  dp3300|dp3300-ascii)
	t=$(pdp_tool dp3300) || missing dp3300
	gui "$t" -a -B telnet localhost "$PORT_DP3300"
	;;
  type340)
	# The Type 340 is the KA10's own display (dpy), not a separate program.
	# Upstream's type340.expect cycled it in the simh session to bring its
	# window back after it was closed; do the same through pidp10-session.
	ses="$PIDP10_LIBEXEC/pidp10-session"
	"$ses" pidp10 stuff $'\005' || exit 1
	sleep 1
	"$ses" pidp10 stuff $'set dpy dis\r'; sleep 2
	"$ses" pidp10 stuff $'set dpy ena\r'; sleep 1
	"$ses" pidp10 stuff $'c\r'
	echo "pdp: Type 340 display restarted"
	;;
  sty)
	t=$(pdp_tool sty) || missing sty
	client tilix "\"$t\" -e telnet localhost $PIDP10_CONSOLE_PORT"
	;;
  gt40)
	# A GT40 is a PDP-11 with a VT11 display: Open SIMH's pdp11 running
	# conf/gt40.simh, which connects to ITS line 11 (port 10019). simh's
	# console needs a terminal. Not a bare "pdp11": on a machine that also
	# has the PiDP-11, /usr/bin/pdp11 is its control tool, and Fedora's
	# simh-pdp11 (3.12) cannot run gt40.simh. The open-simh package's own
	# /usr/bin/gt40 runs its gt40.ini, not this ITS wiring.
	p=${PIDP10_PDP11:-open-simh-pdp11}
	t=$(pdp_tool "$p") || missing "$p"
	client xterm "\"$t\" \"$PIDP10_PREFIX/conf/gt40.simh\""
	;;
  pdp6)
	# The PDP-6 has no telnet console: its console is its screen session, so
	# the PDP-6 terminal and its sim> prompt are one place.
	exec "$PIDP10_LIBEXEC/pidp10-session" pidp6 attach
	;;
  pdp6-tty)
	echo "pdp: the PDP-6 console is its screen session now: 'pdp pdp6'" >&2
	exit 2
	;;
  tv11-tty)
	echo "pdp: tv11-tty is not offered by this package; for the Knight TV" >&2
	echo "pdp: use 'pdp tvcon' (tv11 runs as pidp10-tv11@.service)." >&2
	exit 2
	;;
  -h|--help|help)
	usage
	;;
  *)
	echo "pdp: unknown command '$cmd'" >&2
	usage
	exit 2
	;;
esac
